# ---------------------------------------------------------------------------
# Mozaik Pavers — environment configuration
# Copy to .env.local for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public URL of the site (used in emails, PDF links and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Leave empty for the embedded development database (stored in .data/pglite).
# Production: a PostgreSQL / Supabase connection string.
# DATABASE_URL=postgres://user:password@host:5432/mozaik
# DATABASE_SSL=true            # set "false" for a local Postgres without TLS
# DATABASE_PREPARE=false       # set "false" when using a transaction pooler (Supabase :6543)
# DB_AUTO_MIGRATE=false        # "true" runs migrations + seed at first connection

# --- Admin authentication ---------------------------------------------------
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# First administrator (created by the seed when no users exist). 12+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Email ------------------------------------------------------------------
# resend (production) or file (development: writes to .data/outbox)
EMAIL_TRANSPORT=file
RESEND_API_KEY=
EMAIL_FROM="Mozaik Pavers <sales@mozaikpavers.com>"
# Internal notifications for new leads (optional)
SALES_NOTIFICATION_EMAIL=
# Development only: make the file transport fail to test the retry flow
# EMAIL_SIMULATE_FAILURE=true

# --- Image storage ----------------------------------------------------------
# local (default, files in UPLOAD_DIR served from /media) or supabase
STORAGE_DRIVER=local
UPLOAD_DIR=.data/uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=project-images

# --- Public company details (shown on the site, emails and PDFs) -------------
NEXT_PUBLIC_COMPANY_PHONE=+265 993 897 567
NEXT_PUBLIC_COMPANY_PHONE_2=+265 993 398 028
NEXT_PUBLIC_COMPANY_WHATSAPP=265993897567
NEXT_PUBLIC_COMPANY_EMAIL=info@mozaikpavers.mw
NEXT_PUBLIC_COMPANY_ADDRESS=Lilongwe, Malawi
NEXT_PUBLIC_COMPANY_HOURS=Mon–Fri 7:30–17:00 · Sat 8:00–12:00
NEXT_PUBLIC_COMPANY_FACEBOOK=https://www.facebook.com/mozaikpavers/
NEXT_PUBLIC_COMPANY_INSTAGRAM=https://www.instagram.com/mozaikpavers/

# Seed the starter portfolio of original project photos once (true/false)
SEED_PORTFOLIO=true

LOG_LEVEL=info

# --- Google Sheet of downloaded quotations (optional) -------------------------
# A row is added the first time a customer downloads their quotation PDF.
# Share the sheet (Editor) with the service account email.
GOOGLE_SHEET_ID=1VLf5joQ-IyveDyCwqzH4f8nEBfUpB80vmgwz3kKI-Cw
# GOOGLE_SHEET_TAB=Sheet1          # optional; defaults to the first tab
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
